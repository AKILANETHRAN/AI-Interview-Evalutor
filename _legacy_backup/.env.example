# =========================================
# AI INTERVIEW EVALUATOR — ENVIRONMENT VARS
# =========================================

# ---------- App ----------
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- Database ----------
POSTGRES_USER=interview_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_interview_evaluator
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://interview_user:change_me@postgres:5432/ai_interview_evaluator

# ---------- Auth / JWT ----------
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- AI Provider Abstraction ----------
# Options: claude | openai | local
AI_PROVIDER=claude

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local fallback model settings (no external key required)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------- Redis (optional caching / rate limiting) ----------
REDIS_URL=redis://redis:6379/0

# ---------- Rate limiting ----------
RATE_LIMIT_PER_MINUTE=60

# ---------- Code execution sandbox (Phase 9) ----------
CODE_EXEC_SANDBOX_URL=http://sandbox:9000
CODE_EXEC_TIMEOUT_SECONDS=10

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000/api
